#!/bin/bash
set -euo pipefail

# createswiftpackage generates a Package.swift manifest exposing the iOS
# .xcframework zips as Swift Package Manager binary targets.
#
# The manifest points to the assets that ./script/ghpublish.bash uploads to the
# GitHub release of this build, and pins each one with its SHA-256 checksum,
# which is what `swift package compute-checksum` computes.

if [[ "${GITHUB_REF_TYPE:-}" == "tag" && -n "${GITHUB_REF_NAME:-}" ]]; then
	__tag="${GITHUB_REF_NAME}"
else
	# Keep in sync with ./script/ghpublish.bash, which publishes any other
	# build to the rolling release.
	__tag="rolling"
fi

# GitHub Actions sets GITHUB_REPOSITORY, so a fork's build points to the fork's
# own release rather than to ooni/probe-cli.
__repository="${GITHUB_REPOSITORY:-ooni/probe-cli}"
__base_url="${GITHUB_SERVER_URL:-https://github.com}/${__repository}/releases/download/${__tag}"
__names=(oonimkall libcrypto libevent libssl libtor libz)

{
	cat <<MANIFEST
// swift-tools-version:5.9
// Generated by ./MOBILE/ios/createswiftpackage for ${__tag}; DO NOT EDIT.
import PackageDescription

let package = Package(
    name: "oonimkall",
    platforms: [.iOS(.v12)],
    products: [
        .library(
            name: "oonimkall",
            targets: [
MANIFEST
	for name in "${__names[@]}"; do
		echo "                \"${name}\","
	done
	cat <<MANIFEST
            ]
        ),
    ],
    targets: [
MANIFEST
	for name in "${__names[@]}"; do
		__checksum=$(shasum -a 256 "./MOBILE/ios/${name}.xcframework.zip" | cut -d ' ' -f 1)
		cat <<MANIFEST
        .binaryTarget(
            name: "${name}",
            url: "${__base_url}/${name}.xcframework.zip",
            checksum: "${__checksum}"
        ),
MANIFEST
	done
	cat <<MANIFEST
    ]
)
MANIFEST
} >./MOBILE/ios/Package.swift
